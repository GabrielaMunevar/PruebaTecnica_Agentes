@'
# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Environment variables and credentials
.env
.env.*
!.env.example

# Databases and generated runtime data
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/

# Operating systems
.DS_Store
Thumbs.db
'@ | Set-Content .gitignore